ALTER TABLE job_services
ADD COLUMN is_completed BOOLEAN NOT NULL DEFAULT true;

-- Backfill: assume services on already-completed jobs are done,
-- and anything still pending/in_progress needs review by your team.
-- Since we can't know the true historical state, mark everything
-- under a job that's not yet "completed" as needing a manual check.
UPDATE job_services js
SET is_completed = false
FROM service_jobs sj
WHERE js.job_id = sj.id
AND sj.status != 'completed';



