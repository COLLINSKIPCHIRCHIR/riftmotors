CREATE TABLE document_sequences (
  doc_type VARCHAR(30) PRIMARY KEY,   -- e.g. 'sales_quote', 'sales_invoice', 'delivery_note'
  prefix VARCHAR(20) NOT NULL,        -- e.g. 'RML/Q/'
  last_number INT NOT NULL DEFAULT 0
);

