CREATE TABLE IF NOT EXISTS payslips (
    id SERIAL PRIMARY KEY,

    payroll_period_id INT REFERENCES payroll_periods(id),

    employee_id INT REFERENCES employees(id),

    basic_salary NUMERIC(12,2),

    total_allowances NUMERIC(12,2),

    gross_pay NUMERIC(12,2),

    unpaid_leave_days NUMERIC(6,2),

    unpaid_leave_deduction NUMERIC(12,2),

    taxable_pay NUMERIC(12,2),

    paye_amount NUMERIC(12,2),

    total_statutory_deductions NUMERIC(12,2),

    total_other_deductions NUMERIC(12,2),

    net_pay NUMERIC(12,2),

    status VARCHAR(20) DEFAULT 'Draft',

    paid_at TIMESTAMP,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);