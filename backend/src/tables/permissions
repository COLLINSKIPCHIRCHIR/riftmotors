CREATE TABLE permissions (

id SERIAL PRIMARY KEY,

name VARCHAR(150) UNIQUE NOT NULL,

module VARCHAR(100) NOT NULL,

description TEXT,

created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP

);


