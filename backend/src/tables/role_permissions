INSERT INTO role_permissions(role_id, permission_id)

SELECT
r.id,
p.id

FROM roles r
JOIN permissions p
ON TRUE

WHERE r.name='Sales Manager'

AND (

p.module='vehicles'

OR p.module='customers'

OR p.module='reports'

OR p.name='inventory.view'

);



INSERT INTO role_permissions(role_id, permission_id)

SELECT
    r.id,
    p.id

FROM roles r
JOIN permissions p
ON TRUE

WHERE r.name='Manager'

AND p.name NOT IN (

'users.delete',

'roles.edit',

'permissions.assign',

'settings.edit'

);


